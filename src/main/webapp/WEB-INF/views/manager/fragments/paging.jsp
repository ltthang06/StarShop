<nav><ul class="pagination"><c:if test="${paged.hasPrevious()}"><c:url var="prev" value=""><c:param name="page" value="${paged.number-1}"/><c:param name="keyword" value="${keyword}"/><c:if test="${not empty shopId}"><c:param name="shopId" value="${shopId}"/></c:if><c:if test="${not empty selectedStatus}"><c:param name="status" value="${selectedStatus}"/></c:if></c:url><li class="page-item"><a class="page-link" href="${prev}">Trước</a></li></c:if><li class="page-item disabled"><span class="page-link">${paged.number+1} / ${paged.totalPages == 0 ? 1 : paged.totalPages}</span></li><c:if test="${paged.hasNext()}"><c:url var="next" value=""><c:param name="page" value="${paged.number+1}"/><c:param name="keyword" value="${keyword}"/><c:if test="${not empty shopId}"><c:param name="shopId" value="${shopId}"/></c:if><c:if test="${not empty selectedStatus}"><c:param name="status" value="${selectedStatus}"/></c:if></c:url><li class="page-item"><a class="page-link" href="${next}">Sau</a></li></c:if></ul></nav>
