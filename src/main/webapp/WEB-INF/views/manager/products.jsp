<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ include file="fragments/header.jsp" %>
<h1 class="h3">Kiểm duyệt sản phẩm</h1><p>Mở kiểm duyệt giữ sản phẩm ẩn để Vendor kiểm tra rồi bật lại.</p>
<form class="row g-2 mb-3"><div class="col-md-5"><input class="form-control" name="keyword" value="<c:out value='${keyword}'/>" placeholder="Tên sản phẩm"></div><div class="col-md-2"><input type="number" min="1" class="form-control" name="shopId" value="${shopId}" placeholder="ID shop"></div><div class="col-md-3"><select class="form-select" name="status"><option value="">Mọi trạng thái</option><c:forEach items="${statuses}" var="s"><option value="${s}" ${selectedStatus == s ? 'selected' : ''}>${s}</option></c:forEach></select></div><div class="col-md-2"><button class="btn btn-primary">Tìm</button></div></form>
<c:forEach items="${products.content}" var="p"><div class="card card-body mb-3"><h2 class="h5"><c:out value="${p.name}"/> · #${p.id}</h2><p>Shop: <c:out value="${p.shop.name}"/> (#${p.shop.id}) · Danh mục: <c:out value="${p.category.name}"/></p><p><c:out value="${p.description}"/></p><p>Giá: <fmt:formatNumber value="${p.price}"/> VND · Tồn: ${p.quantity} · ${p.status}</p><c:set var="m" value="${moderations[p.id]}"/><c:if test="${m.blocked}"><div class="alert alert-warning">Đang khóa: <c:out value="${m.reason}"/> · <c:out value="${m.moderatorEmail}"/></div></c:if>
<form method="post" action="${pageContext.request.contextPath}/manager/products/${p.id}/moderate" class="d-flex gap-2 flex-wrap"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="blocked" value="${not m.blocked}"><c:if test="${not m.blocked}"><input class="form-control" name="reason" minlength="10" maxlength="500" required placeholder="Lý do khóa (10–500 ký tự)"></c:if><button class="btn btn-outline-danger">${m.blocked ? 'Mở kiểm duyệt' : 'Khóa sản phẩm'}</button></form></div></c:forEach><c:if test="${empty products.content}"><p>Không có sản phẩm.</p></c:if><c:set var="paged" value="${products}"/><%@ include file="fragments/paging.jsp" %>
<%@ include file="fragments/footer.jsp" %>
