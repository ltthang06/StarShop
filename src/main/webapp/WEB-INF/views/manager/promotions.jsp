<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %><%@ include file="fragments/header.jsp" %>
<div class="d-flex justify-content-between"><h1 class="h3">Voucher hệ thống</h1><a class="btn btn-primary" href="${pageContext.request.contextPath}/manager/promotions/new">Tạo voucher</a></div><form class="d-flex gap-2 my-3"><input class="form-control" name="keyword" value="<c:out value='${keyword}'/>" placeholder="Mã / tên"><button class="btn btn-primary">Tìm</button></form><div class="table-responsive"><table class="table bg-white"><thead><tr><th>Mã / Tên</th><th>Loại / mức giảm</th><th>Hiệu lực</th><th>Còn lại</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${promotions.content}" var="p"><tr><td><c:out value="${p.code}"/><br><c:out value="${p.name}"/></td><td>${p.type}<br>${p.discountValue}</td><td>${p.startAt}<br>${p.endAt}<br>${p.active ? 'Bật' : 'Tắt'}</td><td>${p.quantity}</td><td><a class="btn btn-sm btn-outline-primary" href="${pageContext.request.contextPath}/manager/promotions/${p.id}/edit">Sửa</a><form method="post" action="${pageContext.request.contextPath}/manager/promotions/${p.id}/active"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><input type="hidden" name="active" value="${not p.active}"><button class="btn btn-sm btn-outline-secondary mt-2">${p.active ? 'Tắt' : 'Bật'}</button></form></td></tr></c:forEach></tbody></table></div><c:set var="paged" value="${promotions}"/><%@ include file="fragments/paging.jsp" %>
<%@ include file="fragments/footer.jsp" %>
