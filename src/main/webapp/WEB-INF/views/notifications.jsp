<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>StarShop Thông báo</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"></head><body class="bg-light"><main class="container py-4">
<a href="${pageContext.request.contextPath}/">StarShop · Trang chủ</a><h1 class="h3 mt-3">Thông báo <span id="notification-count" class="badge bg-danger"></span></h1><div id="live-notice" class="alert alert-info" hidden>Có thông báo mới. <a href="">Tải lại danh sách</a></div>
<c:if test="${not empty error}"><p class="text-danger"><c:out value="${error}"/></p></c:if>
<c:forEach items="${notifications.content}" var="n"><div class="card card-body mb-3"><h2 class="h5"><c:out value="${n.title}"/></h2><p><c:out value="${n.content}"/></p><small>${n.createdAt}</small><a href="${pageContext.request.contextPath}<c:out value='${n.targetUrl}'/>">Xem</a><c:if test="${not n.readStatus}"><form method="post" action="${pageContext.request.contextPath}/notifications/${n.id}/read"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-sm btn-outline-secondary mt-2">Đánh dấu đã đọc</button></form></c:if></div></c:forEach>
<c:if test="${empty notifications.content}"><p>Chưa có thông báo.</p></c:if>
<c:if test="${notifications.hasPrevious()}"><a class="btn btn-outline-primary" href="?page=${notifications.number-1}">Trước</a></c:if> <c:if test="${notifications.hasNext()}"><a class="btn btn-outline-primary" href="?page=${notifications.number+1}">Sau</a></c:if>
</main><script src="${pageContext.request.contextPath}/js/notifications.js" defer></script></body></html>
